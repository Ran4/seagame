# Dev/test configuration overrides
# Uncomment and set to true to enable

# Start the ship near a random island (for testing docking)
startNearIsland=true

# Skip docking animation — dock instantly at nearest harbor on startup
instantlyDockToNearestHarbor=true

# Guarantee the first enemy-ship encounter once sailing (combat test aid)
# forceEncounter=true

# Kick off a storm immediately once sailing (weather test aid)
# forceStorm=true

# Guarantee a kraken encounter while sailing in deep water (sea-monster test aid)
# forceKraken=true
